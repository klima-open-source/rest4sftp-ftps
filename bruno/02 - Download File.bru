meta {
  name: 02 - Download File
  type: http
  seq: 2
}

get {
  url: {{base_url}}/file/{{file_path}}
  body: none
  auth: none
}

headers {
  FTP-Host: {{ftp_host}}
  FTP-Port: {{ftp_port}}
  FTP-User: {{ftp_user}}
  FTP-Password: {{ftp_password}}
}

docs {
  Descarga un archivo (application/octet-stream).
  200 OK | 401 credenciales inválidas | 404 ruta no encontrada.
}
